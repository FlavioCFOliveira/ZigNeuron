// Vulkan compute shader for loss backward pass
// Computes gradient of loss w.r.t. output

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer OutputData {
    float output_vals[];
};

layout(set = 0, binding = 1) readonly buffer TargetData {
    float target_vals[];
};

layout(set = 0, binding = 2) writeonly buffer GradOutputData {
    float grad_output_vals[];
};

layout(push_constant) uniform Constants {
    uint size;
    uint loss_type;  // 0=MSE, 1=CrossEntropy, 2=BinaryCrossEntropy
} consts;

const float EPSILON = 1e-8;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= consts.size) return;

    float p = output_vals[idx];
    float t = target_vals[idx];

    // Clamp for numerical stability
    if (p < EPSILON) p = EPSILON;
    if (p > 1.0 - EPSILON) p = 1.0 - EPSILON;

    switch (consts.loss_type) {
        case 0:  // MSE: d/dx (1/n) * sum((y - t)^2) = 2(y - t)
            grad_output_vals[idx] = 2.0 * (p - t);
            break;
        case 1:  // CrossEntropy: -t/p
            grad_output_vals[idx] = -t / p;
            break;
        case 2:  // BinaryCrossEntropy: (p - t) / (p * (1 - p))
            grad_output_vals[idx] = (p - t) / (p * (1.0 - p));
            break;
    }
}
